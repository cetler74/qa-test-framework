# Database Configuration (set DB_NAME to your PostgreSQL database, e.g. linkuup_db or qa_framework)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qa_framework
DB_USER=postgres
DB_PASSWORD=your_actual_password_here

# Server Configuration
PORT=3000
NODE_ENV=development

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Report Configuration
REPORTS_DIR=./reports

# Playwright / UI Tests
PLAYWRIGHT_BASE_URL=https://5gapisprint.meoempresas.pt/apis
PLAYWRIGHT_TIMEOUT_MS=60000
# Set to true to run browser in background (no window). false = browser opens and shows UI for each test.
PLAYWRIGHT_HEADLESS=false
# Optional: Chrome launch args (comma-separated). Default disables Local Network Access prompt for private IPs (e.g. 10.131.65.136).
# PLAYWRIGHT_LAUNCH_ARGS=--disable-features=LocalNetworkAccessCheck
# Optional: Browser User-Agent. Default is a normal Chrome UA to reduce 403 Forbidden from sites that block headless/automation.
# PLAYWRIGHT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Remote Codegen (Xvfb + noVNC) – for headless Linux/Docker servers
# These settings control the remote browser recording sessions used by "Launch Codegen".
# On Windows/desktop with a display, these are ignored (codegen runs locally).
CODEGEN_MAX_SESSIONS=3
CODEGEN_SESSION_TIMEOUT_MS=600000
# CODEGEN_VNC_PORT_START=6080
