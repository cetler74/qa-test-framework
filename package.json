{
  "name": "cg-api-test-framework",
  "version": "1.0.0",
  "description": "API Testing Tool with Postman Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install && npm run migrate",
    "migrate": "node scripts/migrate.js",
    "init-db": "node scripts/init-db.js",
    "test:playwright": "node services/playwrightRunner.js --cli",
    "test:flow-config": "node scripts/validate-flow-config.js",
    "test:flow-editor": "set PLAYWRIGHT_BASE_URL=http://localhost:3001&& playwright test e2e/flow-editor.spec.js --reporter=line",
    "test:run-tests-selection": "set PLAYWRIGHT_BASE_URL=http://localhost:3001&& playwright test e2e/run-tests-selection.spec.js --reporter=line",
    "test:rate-limit": "node --test test/rateLimitValidation.test.js",
    "test:run-cancellation": "node scripts/validate-run-cancellation.js",
    "test:theme-toggle": "node scripts/validate-theme-toggle.js",
    "test:schedule-timezone": "node scripts/validate-schedule-timezone.js",
    "postman-to-swagger": "node scripts/postman-to-swagger.js",
    "test:recorded-spec-template": "node scripts/validate-recorded-spec-template.js"
  },
  "keywords": [
    "api",
    "testing",
    "postman",
    "qa"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.49.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.3.4",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "ldapjs": "^3.0.7",
    "multer": "^1.4.5-lts.1",
    "newman": "^6.2.2",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "playwright": "^1.49.0",
    "sequelize": "^6.35.0",
    "soap": "^1.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "overrides": {
    "jose": "^5.0.0",
    "node-forge": "^1.3.1",
    "object-hash": "^2.0.2",
    "postman-runtime": {
      "node-forge": "^1.3.1"
    }
  }
}
